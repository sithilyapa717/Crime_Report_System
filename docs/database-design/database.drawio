<mxCell id="n438" value="REFERENCE DATA  (lookup lists)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=bottom;fontSize=12;fontStyle=1;fontColor=#6b7280;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="0" y="120" width="400" height="24" as="geometry"/></mxCell>
