{
  "name": "excise-app",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/desktop/renderer/tsconfig.json --noEmit && tsc -p tests/e2e/tsconfig.json --noEmit",
    "test": "vitest run && pnpm run test:documents",
    "lint": "eslint .",
    "format": "prettier --write --ignore-unknown \"packages/shared/**\" \"packages/services/**\" \"apps/desktop/main/**\" \"apps/desktop/preload/**\" \"tests/reports-parity/**\" \"packages/migration/**\" \"packages/db/**\" \"tests/migration/**\" \"tests/database/**\" \"tests/e2e/**\" \"apps/desktop/renderer/**\" \"docs/ui-guidelines/**\" \"scripts/**\" \".githooks/**\" \"*.{json,mjs,ts,yaml}\"",
    "build": "pnpm --filter @excise/renderer run build && pnpm --filter @excise/desktop-main run build",
    "start": "pnpm --filter @excise/desktop-main run start",
    "format:check": "prettier --check --ignore-unknown \"packages/shared/**\" \"packages/services/**\" \"apps/desktop/main/**\" \"apps/desktop/preload/**\" \"tests/reports-parity/**\" \"packages/migration/**\" \"packages/db/**\" \"tests/migration/**\" \"tests/database/**\" \"tests/e2e/**\" \"apps/desktop/renderer/**\" \"docs/ui-guidelines/**\" \"scripts/**\" \".githooks/**\" \"*.{json,mjs,ts,yaml}\"",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "test:unit": "vitest run",
    "test:documents": "node .github/scripts/run-tests.ts unit packages/documents tests/documents-fidelity",
    "import:dry-run": "node tests/migration/run-cli.mjs",
    "db:load-test": "node scripts/load-test.mjs",
    "dev:renderer": "pnpm --filter @excise/renderer run dev",
    "test:e2e": "pnpm build && playwright test -c tests/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
