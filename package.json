{
  "name": "excise-app",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write --ignore-unknown \"packages/shared/**\" \"packages/services/**\" \"!packages/services/reference/**\" \"!packages/services/audit/**\" \"apps/desktop/main/**\" \"apps/desktop/preload/**\" \"tests/reports-parity/**\" \"scripts/**\" \".githooks/**\" \"*.{json,mjs,ts,yaml}\"",
    "build": "pnpm --filter @excise/desktop-main run build",
    "start": "pnpm --filter @excise/desktop-main run start",
    "format:check": "prettier --check --ignore-unknown \"packages/shared/**\" \"packages/services/**\" \"!packages/services/reference/**\" \"!packages/services/audit/**\" \"apps/desktop/main/**\" \"apps/desktop/preload/**\" \"tests/reports-parity/**\" \"scripts/**\" \".githooks/**\" \"*.{json,mjs,ts,yaml}\"",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
